.DS_Store
.env
setup.sh
license.json
locust/__pycache__/*
zookeeper/*
kafka/*
# Certificates and keys — regenerated via ssl-certs/smallstep/renew_certs.sh.
# Templates (.tpl) and the script itself stay tracked.
ssl-certs/**/*.pem
ssl-certs/**/*.key
ssl-certs/**/*.crt
ssl-certs/**/*.csr
ssl-certs/**/*.srl
ssl-certs/.cert-backup-*/
http_content/test.txt
ha-proxy/haproxy.cfg
tmp/*
config/config.cache.json.gz
tcpdump/dns.pcap
